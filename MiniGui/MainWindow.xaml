<Window x:Class="MiniGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniGui" Icon="pack://application:,,,/MiniGui;component/Resources/App.ico"
        Width="960" Height="960" MinWidth="480" MinHeight="480">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="auto"/>
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <!-- Test Plan panel -->
        <GroupBox Grid.Row="0" Header="Test Plan" Margin="0,0,0,12">
            <StackPanel Margin="12,12,12,12">
                <DockPanel Margin="0,0,0,8">

                    <!-- Browse button -->
                    <Button x:Name="BrowseButton" DockPanel.Dock="Right"
                            Padding="10,5" Click="Browse_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/MiniGui;component/Resources/OpenFolder.64.png"
                                Width="16" Height="16" Margin="0,0,6,0" Stretch="Uniform" />
                            <TextBlock Text="Browse..." VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- TapPlan file path -->
                    <Grid Margin="0,0,8,0">
                        <TextBox x:Name="PlanPathBox"
                                AutomationProperties.Name="Test plan path (.TapPlan)"
                                TextChanged="PlanPathBox_TextChanged"
                                KeyDown="PlanPathBox_KeyDown"
                                LostFocus="PlanPathBox_LostFocus"
                                VerticalContentAlignment="Center" />
                        <TextBlock Text="No plan loaded" Margin="6,0,0,0"
                                VerticalAlignment="Center" Foreground="Gray"
                                IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=PlanPathBox}"
                                                    Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                </DockPanel>
                <StackPanel Orientation="Horizontal">

                    <!-- Start button -->
                    <Button x:Name="StartButton"
                            Padding="18,5" Click="Start_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/MiniGui;component/Resources/Play.64.png"
                                Width="16" Height="16" Margin="0,0,6,0" Stretch="Uniform" />
                            <TextBlock Text="Start" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Stop button -->
                    <Button x:Name="StopButton"
                            Padding="18,5" Margin="8,0,0,0" Click="Stop_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/MiniGui;component/Resources/Stop.64.png"
                                Width="16" Height="16" Margin="0,0,6,0" Stretch="Uniform" />
                            <TextBlock Text="Stop" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- State status-->
                    <TextBlock x:Name="StateText" Margin="18,0,0,0"
                            VerticalAlignment="Center" Text="Idle" />

                    <!-- Verdict status -->
                    <TextBlock x:Name="VerdictText" Margin="18,0,0,0"
                            VerticalAlignment="Center" Text="Verdict: -" />

                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Results panel -->
        <GroupBox Grid.Row="1" Header="Results" Padding="-1,6,0,0" Margin="0,0,0,6">
            <ListView x:Name="ResultsList" FontFamily="Consolas"
                      BorderThickness="0"
                      SnapsToDevicePixels="True"
                      UseLayoutRounding="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Item"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.Resources>
                    <Style TargetType="{x:Type GridViewColumnHeader}">
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="6,4,6,4"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Timestamp" Width="110" DisplayMemberBinding="{Binding Timestamp}" />
                        <GridViewColumn Header="Step" Width="140" DisplayMemberBinding="{Binding Source}" />
                        <GridViewColumn Header="Table" Width="120" DisplayMemberBinding="{Binding Table}" />
                        <GridViewColumn Header="Field" Width="120" DisplayMemberBinding="{Binding Field}" />
                        <GridViewColumn Header="Value" Width="300" DisplayMemberBinding="{Binding Value}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <GridSplitter Grid.Row="2" Height="6" Background="Transparent" HorizontalAlignment="Stretch"/>

        <!-- Log panel -->
        <GroupBox Grid.Row="3" Header="Log" Padding="-1,6,0,0" Margin="0,0,0,0">
            <ListView x:Name="LogList" FontFamily="Consolas"
                      FontWeight="Normal"
                      BorderThickness="0"
                      SnapsToDevicePixels="True"
                      UseLayoutRounding="True"
                      SelectionMode="Extended"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Item"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">

                <!-- This is required to handle ALT+C and CTRL+C -->
                <ListView.CommandBindings>
                    <CommandBinding Command="Cut" Executed="ClearLogPanel_Click" />
                    <CommandBinding Command="Copy" Executed="CopyLogPanel_Click" />
                </ListView.CommandBindings>

                <!-- This is required to handle ALT+C and CTRL+C -->
                <ListView.InputBindings>
                    <KeyBinding Key="C" Modifiers="Alt" Command="Cut" />
                    <KeyBinding Key="C" Modifiers="Control" Command="Copy" />
                </ListView.InputBindings>

                <ListView.Resources>
                    <Style TargetType="{x:Type GridViewColumnHeader}">
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="6,4,6,4"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </ListView.Resources>

                <!-- Add line colors -->
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Foreground" Value="{Binding Foreground}" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Timestamp" Width="110" DisplayMemberBinding="{Binding Timestamp}" />
                        <GridViewColumn Header="Source" Width="140" DisplayMemberBinding="{Binding Source}" />
                        <GridViewColumn Header="Message" Width="1600" DisplayMemberBinding="{Binding Message}" />
                    </GridView>
                </ListView.View>

                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Clear Log Panel" InputGestureText="Alt+C"
                                  Click="ClearLogPanel_Click">
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/MiniGui;component/Resources/ClearWindowContent.64.png"
                                       Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy" InputGestureText="Ctrl+C"
                                  Click="CopyLogPanel_Click">
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/MiniGui;component/Resources/Copy.64.png"
                                       Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListView.ContextMenu>

            </ListView>
        </GroupBox>

    </Grid>
</Window>
