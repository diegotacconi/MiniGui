<Window x:Class="MiniGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniGui" Icon="pack://application:,,,/MiniGui;component/Resources/App.ico" Width="780" Height="500" MinWidth="500" MinHeight="300">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Test plan (.TapPlan)" />
            <DockPanel Margin="0,4,0,8">
                <Button DockPanel.Dock="Right" Content="Browse..." Padding="10,4"
                        Click="Browse_Click" x:Name="BrowseButton" />
                <TextBox x:Name="PlanPathBox" Margin="0,0,8,0"
                         VerticalContentAlignment="Center" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="StartButton" Content="Start" Padding="18,5"
                        Click="Start_Click" />
                <Button x:Name="StopButton" Content="Stop" Padding="18,5"
                        Margin="8,0,0,0" Click="Stop_Click" />
                <TextBlock x:Name="StateText" Margin="18,0,0,0"
                           VerticalAlignment="Center" Text="Idle" />
                <TextBlock x:Name="VerdictText" Margin="18,0,0,0"
                           VerticalAlignment="Center" Text="Verdict: -" />
            </StackPanel>
            <TextBlock x:Name="LoadedPlanText" Text="No plan loaded"
                       Margin="0,0,0,8" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <GroupBox Header="OpenTAP log">
            <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </GroupBox>
    </DockPanel>
</Window>
