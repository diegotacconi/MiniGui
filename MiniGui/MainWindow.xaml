<Window x:Class="MiniGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniGui" Icon="pack://application:,,,/MiniGui;component/Resources/App.ico" Width="780" Height="500" MinWidth="500" MinHeight="300">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Test plan (.TapPlan)" />
            <DockPanel Margin="0,4,0,8">
                <Button DockPanel.Dock="Right" Padding="10,4"
                        Click="Browse_Click" x:Name="BrowseButton">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/MiniGui;component/Resources/OpenFolder.64.png"
                               Width="18" Height="18" Margin="0,0,6,0" Stretch="Uniform" />
                        <TextBlock Text="Browse..." VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Grid Margin="0,0,8,0">
                    <TextBox x:Name="PlanPathBox"
                             AutomationProperties.Name="Test plan path (.TapPlan)"
                             TextChanged="PlanPathBox_TextChanged"
                             KeyDown="PlanPathBox_KeyDown"
                             LostFocus="PlanPathBox_LostFocus"
                             VerticalContentAlignment="Center" />
                    <TextBlock Text="No plan loaded" Margin="4,0,0,0"
                               VerticalAlignment="Center" Foreground="Gray"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=PlanPathBox}"
                                                 Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="StartButton" Padding="18,5" Click="Start_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/MiniGui;component/Resources/Play.64.png"
                               Width="18" Height="18" Margin="0,0,6,0" Stretch="Uniform" />
                        <TextBlock Text="Start" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="StopButton" Padding="18,5" Margin="8,0,0,0"
                        Click="Stop_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/MiniGui;component/Resources/Stop.64.png"
                               Width="18" Height="18" Margin="0,0,6,0" Stretch="Uniform" />
                        <TextBlock Text="Stop" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="StateText" Margin="18,0,0,0"
                           VerticalAlignment="Center" Text="Idle" />
                <TextBlock x:Name="VerdictText" Margin="18,0,0,0"
                           VerticalAlignment="Center" Text="Verdict: -" />
            </StackPanel>
        </StackPanel>

        <!-- Start of LogPanel -->   
        <GroupBox Header="OpenTAP log">
            <ListView x:Name="LogList" FontFamily="Consolas" 
                      FontWeight="Normal"
                      BorderThickness="0"
                      SelectionMode="Extended"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">

                <!-- This is required to handle ALT+C and CTRL+C -->
                <ListView.CommandBindings>
                    <CommandBinding Command="Cut" Executed="ClearLogPanel_Click" />
                    <CommandBinding Command="Copy" Executed="CopyLogPanel_Click" />
                </ListView.CommandBindings>

                <!-- This is required to handle ALT+C and CTRL+C -->
                <ListView.InputBindings>
                    <KeyBinding Key="C" Modifiers="Alt" Command="Cut" />
                    <KeyBinding Key="C" Modifiers="Control" Command="Copy" />
                </ListView.InputBindings>

                <ListView.Resources>
                    <Style TargetType="{x:Type GridViewColumnHeader}">
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Padding" Value="6,3,6,3"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                    </Style>
                </ListView.Resources>

                <!-- Add line colors -->
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Foreground" Value="{Binding Foreground}" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Timestamp" Width="110" DisplayMemberBinding="{Binding Timestamp}" />
                        <GridViewColumn Header="Source" Width="140" DisplayMemberBinding="{Binding Source}" />
                        <GridViewColumn Header="Message" Width="1000" DisplayMemberBinding="{Binding Message}" />
                    </GridView>
                </ListView.View>

                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Clear Log Panel" InputGestureText="Alt+C" Click="ClearLogPanel_Click">
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/MiniGui;component/Resources/ClearWindowContent.64.png"
                                       Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="CopyLogPanel_Click">
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/MiniGui;component/Resources/Copy.64.png"
                                       Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListView.ContextMenu>

            </ListView>
        </GroupBox>
        <!-- End of LogPanel -->

    </DockPanel>
</Window>
