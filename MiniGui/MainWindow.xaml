<Window x:Class="MiniGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MiniGui"
        Title="MiniGui" Icon="pack://application:,,,/MiniGui;component/Resources/App.ico"
        Width="960" Height="960" MinWidth="480" MinHeight="480"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Button icon style; dims the icon along with the button text when disabled -->
        <Style x:Key="ButtonIconStyle" TargetType="Image">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Stretch" Value="Uniform" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="auto"/>
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <!-- Test Plan panel -->
        <GroupBox Grid.Row="0" Header="Test Plan" Margin="0,0,0,12">
            <StackPanel Margin="12,12,12,12">
                <DockPanel Margin="0,0,0,8">

                    <!-- Browse button -->
                    <Button x:Name="BrowseButton" DockPanel.Dock="Right"
                            Padding="10,5" Click="Browse_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/MiniGui;component/Resources/OpenFolder.64.png"
                                   Style="{StaticResource ButtonIconStyle}" />
                            <TextBlock Text="Browse..." VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- TapPlan file path -->
                    <Grid Margin="0,0,8,0">
                        <TextBox x:Name="PlanPathBox"
                                AutomationProperties.Name="Test plan path (.TapPlan)"
                                IsReadOnly="True"
                                VerticalContentAlignment="Center" />
                        <TextBlock Text="No plan loaded" Margin="6,0,0,0"
                                VerticalAlignment="Center" Foreground="Gray"
                                IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=PlanPathBox}"
                                                    Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                </DockPanel>
                <StackPanel Orientation="Horizontal">

                    <!-- Start button -->
                    <Button x:Name="StartButton"
                            Padding="18,5" Click="Start_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/MiniGui;component/Resources/Play.64.png"
                                   Style="{StaticResource ButtonIconStyle}" />
                            <TextBlock Text="Start" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Stop button -->
                    <Button x:Name="StopButton"
                            Padding="18,5" Margin="8,0,0,0" Click="Stop_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/MiniGui;component/Resources/Stop.64.png"
                                   Style="{StaticResource ButtonIconStyle}" />
                            <TextBlock Text="Stop" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- State status-->
                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">

                        <!-- Activity ring, shown only while Running or Stopping; Hidden (not Collapsed) keeps its slot reserved -->
                        <Path x:Name="ActivityRing" Width="14" Height="14" Margin="0,0,6,0"
                              VerticalAlignment="Center" Visibility="Hidden"
                              Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"
                              Data="M 7,1 A 6,6 0 1 1 1,7">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="ActivityRingRotation" Angle="0" />
                            </Path.RenderTransform>
                        </Path>

                        <!-- Hidden longest-text sizers reserve a stable width for the state label -->
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="No plan loaded" Visibility="Hidden" />
                            <TextBlock Text="Stopping after 9999.99 s" Visibility="Hidden" />
                            <TextBlock Text="Completed in 9999.99 s" Visibility="Hidden" />
                            <TextBlock Text="Aborted after 9999.99 s" Visibility="Hidden" />
                            <TextBlock Text="Failed after 9999.99 s" Visibility="Hidden" />
                            <TextBlock x:Name="StateText" Text="Idle" />
                        </Grid>
                    </StackPanel>

                    <!-- Verdict status; hidden sizer reserves width for the longest OpenTAP verdict -->
                    <Grid Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Verdict: Inconclusive" Visibility="Hidden" />
                        <TextBlock x:Name="VerdictText" Text="Verdict: -" />
                    </Grid>

                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Results panel -->
        <GroupBox Grid.Row="1" Header="Results" Padding="-1,6,0,0" Margin="0,0,0,6">
            <ListView x:Name="ResultsList" FontFamily="Consolas"
                      BorderThickness="0"
                      SnapsToDevicePixels="True"
                      UseLayoutRounding="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Item"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">

                <ListView.CommandBindings>
                    <CommandBinding Command="{x:Static local:MainWindow.ClearCommand}" Executed="ClearResultsPanel_Click" />
                    <CommandBinding Command="Copy" Executed="CopyResultsPanel_Click" />
                </ListView.CommandBindings>

                <ListView.InputBindings>
                    <KeyBinding Key="L" Modifiers="Control" Command="{x:Static local:MainWindow.ClearCommand}" />
                    <KeyBinding Key="C" Modifiers="Control" Command="Copy" />
                </ListView.InputBindings>

                <ListView.Resources>
                    <Style TargetType="{x:Type GridViewColumnHeader}">
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="6,4,6,4"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Timestamp" Width="110" DisplayMemberBinding="{Binding Timestamp}" />
                        <GridViewColumn Header="Step" Width="140" DisplayMemberBinding="{Binding Source}" />
                        <GridViewColumn Header="Table" Width="120" DisplayMemberBinding="{Binding Table}" />
                        <GridViewColumn Header="Field" Width="120" DisplayMemberBinding="{Binding Field}" />
                        <GridViewColumn Header="Value" Width="300" DisplayMemberBinding="{Binding Value}" />
                    </GridView>
                </ListView.View>

                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Clear" InputGestureText="Ctrl+L"
                                  Click="ClearResultsPanel_Click">
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/MiniGui;component/Resources/ClearWindowContent.64.png"
                                       Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy" InputGestureText="Ctrl+C"
                                  Click="CopyResultsPanel_Click">
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/MiniGui;component/Resources/Copy.64.png"
                                       Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>
        </GroupBox>

        <GridSplitter Grid.Row="2" Height="6" Background="Transparent" HorizontalAlignment="Stretch"/>

        <!-- Log panel -->
        <GroupBox Grid.Row="3" Header="Log" Padding="-1,6,0,0" Margin="0,0,0,0">
            <ListView x:Name="LogList" FontFamily="Consolas"
                      FontWeight="Normal"
                      BorderThickness="0"
                      SnapsToDevicePixels="True"
                      UseLayoutRounding="True"
                      SelectionMode="Extended"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Item"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">

                <ListView.CommandBindings>
                    <CommandBinding Command="{x:Static local:MainWindow.ClearCommand}" Executed="ClearLogPanel_Click" />
                    <CommandBinding Command="Copy" Executed="CopyLogPanel_Click" />
                </ListView.CommandBindings>

                <ListView.InputBindings>
                    <KeyBinding Key="L" Modifiers="Control" Command="{x:Static local:MainWindow.ClearCommand}" />
                    <KeyBinding Key="C" Modifiers="Control" Command="Copy" />
                </ListView.InputBindings>

                <ListView.Resources>
                    <Style TargetType="{x:Type GridViewColumnHeader}">
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="6,4,6,4"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </ListView.Resources>

                <!-- Add line colors -->
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Foreground" Value="{Binding Foreground}" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Timestamp" Width="110" DisplayMemberBinding="{Binding Timestamp}" />
                        <GridViewColumn Header="Source" Width="140" DisplayMemberBinding="{Binding Source}" />
                        <GridViewColumn Header="Message" Width="1600" DisplayMemberBinding="{Binding Message}" />
                    </GridView>
                </ListView.View>

                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Clear" InputGestureText="Ctrl+L"
                                  Click="ClearLogPanel_Click">
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/MiniGui;component/Resources/ClearWindowContent.64.png"
                                       Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy" InputGestureText="Ctrl+C"
                                  Click="CopyLogPanel_Click">
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/MiniGui;component/Resources/Copy.64.png"
                                       Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListView.ContextMenu>

            </ListView>
        </GroupBox>

    </Grid>
</Window>
