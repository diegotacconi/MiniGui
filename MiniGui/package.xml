<?xml version="1.0" encoding="utf-8"?>

<Package Name="MiniGui" Version="0.0.2" OS="Windows" Architecture="AnyCPU" xmlns="http://opentap.io/schemas/package">
  <Description>Minimal WPF operator window for running OpenTAP plans.</Description>
  <SourceUrl>https://github.com/diegotacconi/TapMiniGui</SourceUrl>

  <Dependencies>
    <PackageDependency Package="OpenTAP" />
  </Dependencies>

  <Files>
    <File Path="Packages/MiniGui/MiniGui.dll" SourcePath="MiniGui.dll" />
    <!-- Bundled so one TapPackage installs the GUI and its test steps.
         To separate later, remove this line and add a PackageDependency
         on MiniGui.TestSteps instead. -->
    <File Path="Packages/MiniGui/MiniGui.TestSteps.dll" SourcePath="MiniGui.TestSteps.dll" />
  </Files>

</Package>